{
  "name": "video-downloader",
  "version": "1.0.0",
  "description": "Video Downloader - Download, crop, resize & compress videos",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win portable --dir"
  },
  "author": "Luc",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "youtube-dl-exec": "^3.0.30"
  },
  "build": {
    "appId": "com.luc.video-downloader",
    "productName": "Video Downloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!node_modules/.cache/**"
    ],
    "asarUnpack": [
      "node_modules/youtube-dl-exec/**",
      "node_modules/@cityssm/**"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "VideoDownloader-Portable-${version}.${ext}"
    }
  }
}
